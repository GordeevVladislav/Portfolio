flowchart TD
    A([Старт]) --> B[Выбрать товар и добавить в корзину]
    B --> C[Проверить доступный остаток]
    C --> D{Остаток есть?}
    D -- Нет --> M1[Сообщение: Товара нет в наличии]
    M1 --> Z1([Конец: товара нет])
    D -- Да --> E[Атомарно зарезервировать на 15 минут]
    E --> F[Подтвердить бронь, показать таймер]
    F --> T((Таймер 15 минут))
    F --> P[Перейти к оформлению: самовывоз]
    T -- Истёк до оформления --> R[Снять бронь, вернуть в доступные]
    R --> M2[Сообщение: Бронь истекла]
    M2 --> Z2([Конец: бронь снята])
    P --> G[Проверить сумму платных товаров]
    G --> H{Сумма от 2000 руб.?}
    H -- Да --> I[Добавить наклейки с ценой 0 руб.]
    H -- Нет --> J
    I --> J[Создать заказ: Ожидает оплаты, продлить бронь на время оплаты]
    J --> Q[Оплатить картой на сайте]
    Q --> K{Платёж подтверждён?}
    K -- Да --> L[Списать остаток, статус Оплачен]
    L --> N[Подтверждение: самовывоз и адрес магазина]
    N --> Z3([Конец: заказ оплачен])
    K -- Нет или таймаут --> O[Снять бронь, статус Отменён]
    O --> Z4([Конец: оплата не прошла])
